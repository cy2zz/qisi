# Copy to repository-root .env.local; placeholders only, never commit secrets.
MODEL_BASE_URL=
MODEL_API_STYLE=
MODEL_API_KEY=
MODEL_TEXT_ID=
MODEL_VISION_ID=
TEACHER_PASSWORD_HASH=
APP_ORIGIN=http://localhost:3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=qisi
MYSQL_USER=qisi_app
MYSQL_PASSWORD=
MYSQL_TLS_CA_FILE=
MYSQL_REQUIRE_TLS=0
MYSQL_CONNECTION_LIMIT=10
# Production remote MySQL requires verified TLS; empty CA may use system trust.
# mysql2 session: utf8mb4, time_zone='+00:00', READ COMMITTED; parameterized queries only.
MEDIA_ROOT=./private/media
MODEL_PROVIDER=fixture
REAL_MODEL=0
DEMO_FIXTURE=1
# Production refuses fixture or missing credentials unless an explicitly labelled demo.
# Never expose MYSQL_*, MODEL_API_KEY or TEACHER_PASSWORD_HASH as NEXT_PUBLIC_*.
