{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lines"
  ],
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "text",
          "uncertain"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "maxLength": 12000
          },
          "uncertain": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
