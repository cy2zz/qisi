<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Agent 编排对照｜两条入口不能互相替代验收" id="orchestration"><mxGraphModel dx="1570" dy="1530" grid="1" page="1" pageScale="1" pageWidth="1570" pageHeight="1530"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Agent 编排对照｜两条入口不能互相替代验收" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=28;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1510" height="60" as="geometry"/></mxCell><mxCell id="left" value="主链：BankFlow → /problems/chat" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="660" height="50" as="geometry"/></mxCell><mxCell id="right" value="B链：SessionPage → /tutor/turn" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="850" y="90" width="660" height="50" as="geometry"/></mxCell><mxCell id="mainStart" value="reserveTurn → 恢复题目 / ready包或受限fallback&#xa;TurnTimeBudget：节点25秒 / 全轮90秒" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="660" height="110" as="geometry"/></mxCell><mxCell id="mainDiag" value="Diagnosis：确认的证据 → 判断 / 卡点 / 复核请求" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="370" width="660" height="100" as="geometry"/></mxCell><mxCell id="mainRoute" value="可选：Preparation(route_review) → route Guard&#xa;审核学生异解，保留合格路线补丁" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="660" height="100" as="geometry"/></mxCell><mxCell id="mainStrategy" value="Strategy → Renderer&#xa;决定干预、台阶、获准事实，再组织学生话术" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="750" width="660" height="100" as="geometry"/></mxCell><mxCell id="mainGuard" value="Guard → gateTurn（确定性 PolicyGate）&#xa;边界不合格：中性拒绝 / 错误，不无限重写" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="940" width="660" height="100" as="geometry"/></mxCell><mxCell id="mainCommit" value="A commitTurn 最终事务 → SSE chunk / done&#xa;节点审计 ≠ 提交；禁止先流出未检查模型文本" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="1130" width="660" height="110" as="geometry"/></mxCell><mxCell id="bStart" value="初始化 GET /session/:id 缺失；POST自身已接线&#xa;A reserveTurn → LearningTurnStore → Orchestrator" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="180" width="660" height="110" as="geometry"/></mxCell><mxCell id="bDiag" value="Diagnosis.runChecked&#xa;BudgetLedger + BudgetedModelPort 受控模型调用" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="370" width="660" height="100" as="geometry"/></mxCell><mxCell id="bRoute" value="生产接线 routeReviewInput = null&#xa;异解 / skip / reveal 等未完整接入" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="850" y="560" width="660" height="100" as="geometry"/></mxCell><mxCell id="bStrategy" value="Strategy.runChecked → Renderer → Guard&#xa;需要时最多一次表达重写，再 Guard" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="750" width="660" height="100" as="geometry"/></mxCell><mxCell id="bGuard" value="gateTurn → StorePort.commitChecked&#xa;安全 StudentView，不是原始模型输出" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="940" width="660" height="100" as="geometry"/></mxCell><mxCell id="bCommit" value="LearningTurnStore → A commitTurn → JSON&#xa;claimRecovery明确未实现；并非自动崩溃续跑" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="1130" width="660" height="110" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mainStart" target="mainDiag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="需要复核时；否则跳过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mainDiag" target="mainRoute"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mainRoute" target="mainStrategy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mainStrategy" target="mainGuard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mainGuard" target="mainCommit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bStart" target="bDiag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="未接分支" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="bDiag" target="bRoute"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="直接进入策略" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bDiag" target="bStrategy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="420"/><mxPoint x="800" y="800"/></Array></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bStrategy" target="bGuard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bGuard" target="bCommit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="assessment" value="独立检验是另一阶段：新任务 → 冻结首次计划/答案 → Assessment → Guard → 代码算独立性&#xa;真实实现：A 的 AssessmentService；不是聊天每轮都调用，也不是一个统一 LangGraph 已包办所有阶段" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="1310" width="1460" height="110" as="geometry"/></mxCell><mxCell id="legend" value="紫：模型角色/编排   绿：事务/证据   黄：代码门禁或入口限制   红虚线：生产未接。当前没有自由群聊、无限循环或真实StateGraph。" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="50" y="1440" width="1460" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>