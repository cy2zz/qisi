<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="从选题到独立证据｜按 ① ↓ ② ↑ ③ ↓ 阅读" id="learning-flow"><mxGraphModel dx="1620" dy="1370" grid="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1370"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="从选题到独立证据｜按 ① ↓ ② ↑ ③ ↓ 阅读" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=28;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1560" height="60" as="geometry"/></mxCell><mxCell id="lane1" value="① 选题与输入 ↓" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="420" height="50" as="geometry"/></mxCell><mxCell id="lane2" value="② 单轮教学与核对 ↑" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="420" height="50" as="geometry"/></mxCell><mxCell id="lane3" value="③ 撤去帮助后检验 ↓" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="420" height="50" as="geometry"/></mxCell><mxCell id="select" value="登录 → 筛选 / 随机选题&#xa;服务端按 questionId 取真实题目" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="420" height="120" as="geometry"/></mxCell><mxCell id="analyze" value="POST /problems/analyze&#xa;题图必要时先转写&#xa;公开读题 + 私有备课可并行" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="420" height="120" as="geometry"/></mxCell><mxCell id="prepare" value="Preparation → 结构校验 → Guard&#xa;产出参考解 / 决策路线 / 检验候选" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="610" width="420" height="120" as="geometry"/></mxCell><mxCell id="ready" value="绑定 packetVersion 并建会话&#xa;未 ready 也可能建会话，但受限&#xa;不换简单题，不伪称准备成功" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="830" width="420" height="120" as="geometry"/></mxCell><mxCell id="input" value="学生输入自己的思路&#xa;文字 / 公式 / 语音 / 手写&#xa;手写必须先确认当前 revision" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="1050" width="420" height="120" as="geometry"/></mxCell><mxCell id="reserve" value="POST /problems/chat → reserveTurn&#xa;身份 / Origin / 幂等 / version&#xa;取得有效 lease 与 deadline" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="1050" width="420" height="120" as="geometry"/></mxCell><mxCell id="diagnosis" value="Diagnosis：有证据地定位卡点&#xa;必要时 Preparation 异解复核&#xa;再由 route Guard 审核" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="830" width="420" height="120" as="geometry"/></mxCell><mxCell id="strategy" value="Strategy：决定下一小步&#xa;结合帮助深度、曝光与探针余量&#xa;同一目标最多两个探针" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="610" width="420" height="120" as="geometry"/></mxCell><mxCell id="render" value="Renderer → Guard → PolicyGate&#xa;只表达获准内容&#xa;拒绝则中性提示或错误，不乱发答案" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="390" width="420" height="120" as="geometry"/></mxCell><mxCell id="commit" value="commitTurn 最终事务复查&#xa;保存消息 / 曝光 / 探针 / 状态&#xa;成功后才发 chunk + done(version)" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="170" width="420" height="120" as="geometry"/></mxCell><mxCell id="original" value="继续讨论或 finish_problem 核对&#xa;正确 / 不正确 / 不确定&#xa;原题做对 ≠ 独立学会" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="420" height="120" as="geometry"/></mxCell><mxCell id="newtask" value="start / reassess：未见新任务&#xa;候选或受控生成 → Guard&#xa;过滤已见与近重复任务" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="390" width="420" height="120" as="geometry"/></mxCell><mxCell id="freeze" value="首次计划 → lockPlan&#xa;随后作答 → freezeAnswer&#xa;请求帮助、实际曝光分别记账" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="610" width="420" height="120" as="geometry"/></mxCell><mxCell id="assess" value="Assessment → Guard&#xa;规划 / 执行分别评分&#xa;不可靠则 unknown，不下掌握结论" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="830" width="420" height="120" as="geometry"/></mxCell><mxCell id="report" value="代码计算本次独立通过 → 报告&#xa;首次见 + 近迁移 + 无求助/曝光 + 有效&#xa;规划与执行都正确；历史 / owner删除" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="1050" width="420" height="120" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="select" target="analyze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analyze" target="prepare"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prepare" target="ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ready" target="input"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="可进入检验时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="original" target="newtask"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="newtask" target="freeze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="freeze" target="assess"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="assess" target="report"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="提交" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="input" target="reserve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="reserve" target="diagnosis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="diagnosis" target="strategy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="strategy" target="render"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="render" target="commit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="展示" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="commit" target="original"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge15" value="补学后换题重测" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=17;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="report" target="newtask"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="1110"/><mxPoint x="1570" y="450"/></Array></mxGeometry></mxCell><mxCell id="note" value="下一轮学生回答，重复②；失败保留输入、不推进版本。独立检验未通过时回流补学，再换题重测。" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="1200" width="1460" height="60" as="geometry"/></mxCell><mxCell id="legend" value="蓝：学生动作/业务   紫：模型角色   绿：持久证据/事务   黄：状态边界。当前主链图，不替代完整AT/ST验收。" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fillColor=none;strokeColor=none;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="50" y="1270" width="1460" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>